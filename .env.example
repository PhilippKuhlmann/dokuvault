APP_NAME=DokuVault
APP_ENV=local
# Nur fuer eine oeffentliche Demo: zeigt einen Hinweis und entsperrt
# `php artisan demo:reset`, der die Datenbank komplett zuruecksetzt.
DEMO_MODE=false
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dokumentation
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Sessions verschlüsselt speichern (empfohlen: true)
SESSION_ENCRYPT=true
# Cookies nur über HTTPS senden — in Produktion true (Default: automatisch true bei APP_ENV=production)
SESSION_SECURE_COOKIE=

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

BACKUP_NOTIFICATION_EMAIL=admin@example.com

# Kennwort für das Backup-Archiv. Dringend empfohlen:
#
# Die Sicherung umfasst das ganze Projektverzeichnis, also auch die .env - und
# darin steht der APP_KEY, mit dem die Kennwörter in der Datenbank
# verschlüsselt sind. Ohne Archivkennwort liegt in einer Sicherung der Tresor
# neben seinem Schlüssel, und die Verschlüsselung in der Datenbank ist für
# jeden wertlos, der an die Sicherung kommt.
#
# Das Kennwort gehört NICHT in dieselbe Sicherung - es steht hier, weil es
# beim Entpacken gebraucht wird, und muss anderswo aufbewahrt werden.
BACKUP_ARCHIVE_PASSWORD=

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
